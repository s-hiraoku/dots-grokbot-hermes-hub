{
  "version": 1,
  "mode": "auth0",
  "enabled": false,
  "oauth": {
    "issuer": "https://example-tenant.jp.auth0.com/",
    "resource": "https://hub.example/hab/mcp",
    "scopes": [
      "hub:submit",
      "hub:get",
      "hub:cancel",
      "hub:ping_submit",
      "hub:ping_get",
      "hub:ping_reply",
      "hub:ping_pending"
    ]
  },
  "subjects": [
    {
      "subject": "example-grok-subject",
      "kind": "user",
      "clientId": "example-grok-client",
      "destination": "hermes",
      "taskTypes": ["connectivity_check"],
      "operations": [
        "submit",
        "get",
        "cancel",
        "ping_submit",
        "ping_get",
        "ping_reply",
        "ping_pending"
      ]
    },
    {
      "subject": "example-dots-subject",
      "kind": "user",
      "clientId": "example-dots-client",
      "operations": ["ping_submit", "ping_get", "ping_reply", "ping_pending"]
    },
    {
      "subject": "example-worker-subject",
      "kind": "service",
      "clientId": "example-worker-client",
      "worker": "hermes",
      "runnerScope": "example-reviewed-runner-boundary",
      "taskTypes": ["connectivity_check"],
      "operations": ["claim", "get", "heartbeat", "complete"]
    }
  ],
  "ping": {
    "dots": {
      "subject": "example-dots-subject",
      "clientId": "example-dots-client"
    },
    "grok": {
      "subject": "example-grok-subject",
      "clientId": "example-grok-client"
    }
  }
}
