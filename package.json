{
  "name": "agent-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "npm run build && node --test test/*.test.js",
    "check": "tsc --noEmit",
    "lint": "eslint src db test",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "schema:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "drizzle-orm": "^0.45.3",
    "ipaddr.js": "^2.5.0",
    "standardwebhooks": "^1.1.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261004.1",
    "@types/node": "^26.6.4",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "miniflare": "5.20261001.0-alpha",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "$esbuild"
    }
  }
}
